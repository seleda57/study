window.addEventListener('keydown',function(e){
  var k=e.key;if(mode!=='play')return;
  if(k==='ArrowLeft'||k==='a')mv(-1);else if(k==='ArrowRight'||k==='d')mv(1);
  else if(k==='ArrowUp'||k==='w'||k===' ')jump();else if(k==='ArrowDown'||k==='s')slide();else return;
  e.preventDefault();
});
var sx=0,sy=0,sdn=false;
